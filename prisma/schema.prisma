model FranchiseProposal {
  id               String         @id @default(cuid())
  proposalCode     String?        @unique
  requestId        String
  franchiseId      String
  status           ProposalStatus @default(SENT)
  attemptNumber    Int
  distanceKm       Decimal?       @db.Decimal(10, 2)
  proposedAt       DateTime       @default(now())
  expiresAt        DateTime?
  respondedAt      DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  expiredAt        DateTime?
  cancellationNote String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  responseTime     Int?

  request      OrderRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  franchise    Franchise              @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]

  @@unique([requestId, franchiseId])
  @@unique([requestId, attemptNumber])
  @@index([requestId, status])
  @@index([franchiseId, status])
  @@index([status, expiresAt])
