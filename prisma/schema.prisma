model OrderRequest {
  id                          String             @id @default(cuid())
  customerId                  String
  status                      OrderRequestStatus @default(SEARCHING_FRANCHISE)
  latitude                    Float
  longitude                   Float
  addressJson                 Json
  giftMessage                 String?
  giftWrap                    Boolean            @default(false)
  giftWrapperFee              Decimal            @default(0.00) @db.Decimal(10, 2)
  isInterState                Boolean            @default(false)
  requestSnapshot             Json?
  maxFranchiseAttempts        Int                @default(10)
  attemptCount                Int                @default(0)
  proposalTimeoutMinutes      Int                @default(3)
  reservationTimeoutMinutes   Int                @default(15)
  totalAmount                 Decimal?           @db.Decimal(12, 2)
  selectedFranchiseId         String?
  acceptedProposalId          String?
  actualOrderId               String?            @unique
  warehouseFulfillmentOrderId String?            @unique
  failureReason               String?
  searchingStartedAt          DateTime           @default(now())
  acceptedAt                  DateTime?
  failedAt                    DateTime?
  cancelledAt                 DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  cartId                      String?
  discountCode                String?

  customer                  Customer?                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  selectedFranchise         Franchise?                 @relation(fields: [selectedFranchiseId], references: [id])
  order                     Order?                     @relation("OrderRequestToOrder")
  warehouseFulfillmentOrder WarehouseFulfillmentOrder? @relation("OrderRequestToWarehouseFulfillment")
  items                     OrderRequestItem[]
  proposals                 FranchiseProposal[]
  reservations              InventoryReservation[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([selectedFranchiseId, status])
  @@index([cartId])
