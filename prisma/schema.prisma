  returnRequestId String?
  returnRequest   ReturnRequest? @relation("ReturnInvoices", fields: [returnRequestId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  refunds Refund[] @relation("InvoiceRefunds")

  @@index([orderId])
  @@index([parentInvoiceId])
  @@index([returnRequestId])
  @@index([stockRequestId])
  @@index([status])
  @@index([awb])
  @@index([issuedAt])
}

