model Cart {
  id String @id @default(uuid())

  // -------------------------
  // Ownership (who owns cart)
  // -------------------------
  userId String?
  user   User?   @relation("CustomerCarts", fields: [userId], references: [id])

  // -------------------------
  // Relations
  // -------------------------
  items CartItem[]

  // -------------------------
  // Cart Summary Fields
  // -------------------------
  itemsCount  Int     @default(0)
  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  // -------------------------
  // Status & Currency
  // -------------------------
  status   CartStatus @default(ACTIVE)
  currency String     @default("INR")

  // -------------------------
  // Guest / Session Support
  // -------------------------
  sessionId String?

  // -------------------------
  // Expiry & Stock Locking
  // -------------------------
  expiresAt     DateTime?
  stockLockedAt DateTime?
  lockExpiresAt DateTime?

  // -------------------------
  // Merge Support
  // -------------------------
  isMerged Boolean   @default(false)
  mergedAt DateTime?

  // -------------------------
  // Source Tracking
  // -------------------------
  source CartSource @default(USER)

  // -------------------------
  // Timestamps
  // -------------------------
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Indexes
  // -------------------------
  @@index([userId])
  @@index([status, expiresAt, lockExpiresAt])
  @@index([sessionId, status])
}

// ======================================================
// CART ITEM MODEL
// ======================================================

model CartItem {
  id String @id @default(uuid())

  // -------------------------
  // Relations
  // -------------------------
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // -------------------------
  // Product Info
  // -------------------------
  productId String
  variantId String?

  // -------------------------
  // Quantity & Price Snapshot
  // -------------------------
  quantity        Int
  priceAtAddition Decimal @db.Decimal(12, 2)

  // -------------------------
  // Timestamps
  // -------------------------
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate product in same cart
  @@unique([cartId, productId, variantId])
  // -------------------------
  // Indexes
  // -------------------------
  @@index([cartId])
  @@index([productId])
}

