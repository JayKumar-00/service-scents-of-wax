# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_ENV=development
METRICS_ENABLED=true

CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,https://ezzme.com,https://dev-ezzme.com,https://dev-api.ezzme.com,https://dev-franchise.ezzme.com,https://dev-admin.ezzme.com

# PostgreSQL — writer (migrations + writes) and reader (read replica)
WRITER_DB_URL=postgresql://user:pass@localhost:5432/giftfactory_dev?schema=public
READER_DB_URL=postgresql://user:pass@localhost:5432/giftfactory_dev?schema=public

# Prisma (optional if WRITER_DB_URL is set; entrypoint maps writer → these)
DATABASE_URL=postgresql://user:pass@localhost:5432/giftfactory_dev?schema=public
DIRECT_URL=postgresql://user:pass@localhost:5432/giftfactory_dev?schema=public

# ElastiCache Valkey (Redis-compatible). Omit REDIS_USER/PASSWORD when cluster has no AUTH.
CACHE_ENGINE=valkey
REDIS_URI=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# JWT / auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# PDF Generation Browser Path (Fallback to OS auto-detection if not specified)
# Linux example: PDF_BROWSER_PATH=/usr/bin/chromium
# Windows example: PDF_BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
PDF_BROWSER_PATH=

# Google reCAPTCHA
RECAPTCHA_SECRET=your-recaptcha-secret-key
RECAPTCHA_SITE_KEY=your-recaptcha-public-site-key

# Email logo URL (uses public hosted image)
LOGO_URL=https://d3ori68ve27vyu.cloudfront.net/assets/GiftFactoryLogo.png



