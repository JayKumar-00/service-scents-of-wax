  id        String   @id @default(cuid())
  deviceId  String?  @unique
  ip        String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities        GuestActivity[]
  categoryInterests GuestCategoryInterest[]
  brandInterests    GuestBrandInterest[]
  wishlist          GuestWishlist[]
  abandonedCarts    GuestAbandonedCart[]
  retentionSnapshot GuestRetentionSnapshot?
}

model GuestActivity {
  id              String               @id @default(cuid())
  guestCustomerId String
  type            CustomerActivityType
  productId       String?
  categoryId      String?
  metadata        Json?
  createdAt       DateTime             @default(now())

  guestCustomer GuestCustomer @relation(fields: [guestCustomerId], references: [id], onDelete: Cascade)

  @@index([guestCustomerId])
  @@index([type])
  @@index([createdAt])
}

model GuestCategoryInterest {
  id              String @id @default(cuid())
  guestCustomerId String
  categoryId      String
  score           Int    @default(0)

  guestCustomer GuestCustomer @relation(fields: [guestCustomerId], references: [id], onDelete: Cascade)

  @@unique([guestCustomerId, categoryId])
}

model GuestWishlist {
  id              String   @id @default(cuid())
  guestCustomerId String
  productId       String
  variantId       String?
  createdAt       DateTime @default(now())

  guestCustomer GuestCustomer   @relation(fields: [guestCustomerId], references: [id], onDelete: Cascade)
  product       Product         @relation("GuestWishlistProduct", fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation("GuestWishlistVariant", fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([guestCustomerId, productId, variantId])
  @@index([guestCustomerId])
}

model GuestAbandonedCart {
  id              String    @id @default(cuid())
  guestCustomerId String
  cartId          String
  detectedAt      DateTime
  notifiedAt      DateTime?
  recoveredAt     DateTime?
  couponCode      String?

  guestCustomer GuestCustomer @relation(fields: [guestCustomerId], references: [id], onDelete: Cascade)

  @@index([guestCustomerId])
}

model GuestRetentionSnapshot {
  guestCustomerId String                 @id @unique
  stage           CustomerLifecycleStage @default(NEW_VISITOR)
  engagementCount Int                    @default(0)
  engagementScore Int                    @default(0)
  topCategories   Json?
  topBrands       Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  guestCustomer GuestCustomer @relation(fields: [guestCustomerId], references: [id], onDelete: Cascade)
}

model CustomerBrandInterest {
  id         String @id @default(cuid())
  customerId String
  brandId    String
  score      Int    @default(0)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, brandId])
}

model GuestBrandInterest {
  id              String @id @default(cuid())
  guestCustomerId String
  brandId         String
  score           Int    @default(0)

  guestCustomer GuestCustomer @relation(fields: [guestCustomerId], references: [id], onDelete: Cascade)

  @@unique([guestCustomerId, brandId])
}

enum KycDocumentType {
  AADHAAR
  PAN
  VOTER_ID
  DRIVING_LICENSE
  PASSPORT
  GSTIN
  BANK
  UPI
  OTHER
}

model UserKyc {
  id           String          @id @default(cuid())
  userId       String          @unique
  email        String          @unique
  idNumber     String
  status       String
  documentType KycDocumentType
  expiryTime   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SettlementType {
  FRANCHISE
  AFFILIATE
}

enum OrderSettlementStatus {
  PENDING
  SETTLED
  FAILED
  CANCELLED
}

model OrderSettlement {
  id                  String                @id @default(cuid())
  orderId             String
  type                SettlementType
  amount              Decimal               @db.Decimal(12, 2)
  status              OrderSettlementStatus @default(PENDING)
  creditTransactionId String?
  affiliateCustomerId String?
  errorReason         String?
  processedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([status])
}

model RetentionNotificationIntent {
  id            String    @id @default(cuid())
  customerId    String
  type          String
  payload       Json
  status        String    @default("PENDING")
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  deferredUntil DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([customerId, status])
  @@index([deferredUntil])
  @@index([customerId, deferredUntil])
  @@index([customerId, createdAt])
  @@index([status, deferredUntil])
  @@index([status, createdAt])
  @@index([retryCount])
}

enum StarterBundleStatus {
  ACTIVE
  INACTIVE
}

enum BundleProvisionMethod {
  STOCK_REQUEST
}

enum BundleAssignmentStatus {
  PENDING
  PROCESSING
  PROVISIONED
  FAILED
}

enum BundleType {
  TRENDING
  BEST_SELLER
  SEASONAL
  CATEGORY
  STARTER
  CUSTOM
}

model StarterBundle {
  id                 String                      @id @default(cuid())
  code               String                      @unique
  name               String
  description        String?
  type               BundleType                  @default(STARTER)
  status             StarterBundleStatus         @default(ACTIVE)
  isDefault          Boolean                     @default(false)
  autoAssignOnCreate Boolean                     @default(false)
  createdByUserId    String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  items              StarterBundleItem[]
  assignments        FranchiseBundleAssignment[]
  createdBy          User?                       @relation("BundleCreatedBy", fields: [createdByUserId], references: [id])
  paymentStatus      OnlinePaymentStatus         @default(PAID)
  txtId              String?                     @unique
}

model StarterBundleItem {
  id        String          @id @default(cuid())
  bundleId  String
  productId String
  variantId String?
  quantity  Int
  bundle    StarterBundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([bundleId, productId, variantId])
}

model FranchiseBundleAssignment {
  id                String                 @id @default(cuid())
  franchiseId       String
  bundleId          String
  status            BundleAssignmentStatus @default(PENDING)
  method            BundleProvisionMethod  @default(STOCK_REQUEST)
  stockRequestId    String?
  inboundDeliveryId String?
  failureReason     String?
  provisionedAt     DateTime?
  createdAt         DateTime               @default(now())
  isPartial         Boolean                @default(false)

  // Details of all provisioned items: [{ productId, variantId, quantity, stockRequestId, inboundDeliveryId }]
  provisionedItems Json?

  franchise       Franchise        @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  bundle          StarterBundle    @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  stockRequest    StockRequest?    @relation(fields: [stockRequestId], references: [id])
  inboundDelivery InboundDelivery? @relation(fields: [inboundDeliveryId], references: [id])

  @@unique([franchiseId, bundleId])
}


enum SupplierReturnStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DISPATCHED
  COMPLETED
  CANCELLED
}

model SupplierReturnOrder {
  id              String               @id @default(cuid())
  returnNumber    String               @unique
  purchaseOrderId String
  supplierId      String
  status          SupplierReturnStatus @default(DRAFT)
  totalAmount     Decimal?             @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  lines         SupplierReturnLine[]
}

model SupplierReturnLine {
  id                    String   @id @default(cuid())
  supplierReturnOrderId String
  productId             String
  variantId             String?
  quantity              Int
  unitCost              Decimal  @db.Decimal(12, 2)
  lineTotal             Decimal  @db.Decimal(12, 2)
  reason                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  supplierReturnOrder SupplierReturnOrder @relation(fields: [supplierReturnOrderId], references: [id], onDelete: Cascade)
  product             Product             @relation(fields: [productId], references: [id])
  variant             ProductVariant?     @relation(fields: [variantId], references: [id])
}

model WarehouseDefectiveInventory {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  quantity  Int
  source    String   @default("QC_REJECTED")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

