datasource db {
  provider  = "postgresql"
  url       = env("WRITER_DB_URL")
  directUrl = env("WRITER_DB_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum ProcurementSupplierStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  // PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum AsnStatus {
  DRAFT
  SUBMITTED
  IN_TRANSIT
  ARRIVED
  CANCELLED
}

enum GrnStatus {
  DRAFT
  // QUALITY_CHECK_PENDING
  // QUALITY_CHECK_PASSED
  // QUALITY_CHECK_FAILED
  POSTED
  REVERSED
  CANCELLED
}

enum QualityInspectionStatus {
  PENDING
  PASSED
  FAILED
  PARTIAL
}

enum LedgerEntryType {
  PURCHASE
  SALE
  RETURN
  TRANSFER
  DAMAGE
  ADJUSTMENT
  BUNDLE_ALLOCATION
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  PENDING
}

enum CustomerStatus {
  BLOCKED
  ACTIVE
  INACTIVE
  ARCHIVED
}

model CustomerAddress {
  id String @id @default(cuid())

  customerId String

  fullName String
  phone    String

  addressLine1 String
  addressLine2 String?

  city  String
  state String

  postalCode String
  country    String @default("INDIA")

  latitude  Float?
  longitude Float?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([fullName])
  @@index([customerId])
  @@index([postalCode])
}

// Walk-in / counter buyer saved per outlet (deduped by normalized phone) and linked from POS orders.
model RetailCustomer {
  id            String    @id @default(cuid())
  franchiseId   String
  /// Digits only, used for upsert (e.g. 919876543210)
  phoneNorm     String
  name          String
  email         String?
  gstin         String?
  billingStreet String?
  billingCity   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  franchise     Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@unique([franchiseId, phoneNorm])
  @@index([franchiseId, updatedAt])
}

model Customer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("CustomerInformation", fields: [userId], references: [id])

  // Additional Fields
  name            String?
  altEmail        String?
  phone           String?        @unique
  gender          Gender?
  dob             DateTime?
  gstin           String?
  isPhoneVerified Boolean        @default(false)
  isEmailVerified Boolean        @default(false)
  status          CustomerStatus @default(ACTIVE)

  avatar      String?
  firebaseUid String?

  // Address (JSON for flexibility)
  addresses CustomerAddress[]

  // Geo location (important for nearest franchise logic)
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation
  searchHistories   SearchHistory[]
  returnInventories ReturnInventory[]
  wishlist          Wishlist[]
  orderRequests     OrderRequest[]
  orders            Order[]
  retentionSnapshot RetentionSnapshot?
  activities        CustomerActivity[]
  categoryInterests CustomerCategoryInterest[]
  brandInterests    CustomerBrandInterest[]
  deviceTokens      DeviceToken[]
  notificationLogs  NotificationLog[]
  abandonedCarts    AbandonedCart[]
  journeys          CustomerJourney[]
  retentionIntents  RetentionNotificationIntent[]
  discountsCreated  Discount[]                  @relation("CustomerDiscounts")

  @@index([latitude, longitude]) // for geo queries
  @@index([name])
  @@index([status])
  @@index([createdAt])
}

enum FranchiseGender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

model Franchise {
  id                     String          @id @default(cuid())
  name                   String
  code                   String          @unique
  status                 FranchiseStatus @default(ACTIVE)
  acceptingOrders        Boolean         @default(true)
  latitude               Float
  longitude              Float
  territory              String?
  addressLine1           String
  city                   String
  postalCode             String
  country                String          @default("INDIA")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  kycStatus              KycStatus       @default(PENDING)
  kycNote                String?
  ownerFullName          String?
  ownerPhone             String?
  ownerEmail             String?
  businessName           String?
  gstNumber              String?
  panNumber              String?
  basicDetailsCompleted  Boolean         @default(false)
  gstDetailsCompleted    Boolean         @default(false)
  sopChecklistCompleted  Boolean         @default(false)
  approvedAt             DateTime?
  approvedByUserId       String?
  kycDocumentType        String?
  kycDocumentNumber      String?
  kycVerifiedAt          DateTime?
  sopTrainingCompleted   Boolean         @default(false)
  sopBrandingCompleted   Boolean         @default(false)
  sopInfraAuditCompleted Boolean         @default(false)
  sopPosSetupCompleted   Boolean         @default(false)
  sopSafetyCompleted     Boolean         @default(false)
  sopLastReviewedAt      DateTime?
  sopNote                String?
  badge                  String[]        @default([])
  state                  String?
  dob                    String?
  gender                 FranchiseGender @default(NOT_SPECIFIED)

  documents          FranchiseDocument[]
  notices            FranchiseNotice[]
  returns            FranchiseReturn[]
  returnInventories  ReturnInventory[]
  stocks             FranchiseStock[]
  inboundDeliveries  InboundDelivery[]
  reservations       InventoryReservation[]
  orders             Order[]
  replenPolicies     ReplenishmentPolicy[]
  retailCustomers    RetailCustomer[]
  stockRequests      StockRequest[]
  stockingNode       StockingNode?
  supportTickets     SupportTicket[]
  users              User[]
  staffMembers       User[]                 @relation("FranchiseOwner")
  shipments          Shipment[]
  orderRequests      OrderRequest[]
  franchiseProposals FranchiseProposal[]

  creditAccount        CreditAccount?
  creditTransaction    CreditTransaction[]
  settlements          FranchiseSettlement[]
  payouts              Payout[]
  returnRequestsV2     ReturnRequest[]             @relation("FranchiseReturnRequestsV2")
  receivedRequestsV2   ReturnRequest[]             @relation("FranchiseReceivedRequestsV2")
  bundleAssignments    FranchiseBundleAssignment[]
  defectiveInventoryV2 DefectiveInventory[]        @relation("FranchiseDefectiveInventoryV2")
  blockedInventoryV2   BlockedInventory[]          @relation("FranchiseBlockedInventoryV2")

  @@index([ownerPhone])
  @@index([ownerEmail])
  @@index([name])
  @@index([code])
  @@index([status])
  @@index([status, acceptingOrders])
  @@index([createdAt])
}

//START--Franchise-Credit-Entities
enum CreditAccountStatus {
  ACTIVE
  FROZEN
  BLOCKED
  CLOSED
}

enum CreditDurationEnum {
  DAY_15
  DAY_30
  DAY_45
}

enum StockRequestPaymentMode {
  CREDIT
  DIRECT
}

model CreditAccount {
  id          String @id @default(cuid())
  franchiseId String @unique

  totalCredit     Decimal             @default(0) @db.Decimal(12, 2)
  usedCredit      Decimal             @default(0) @db.Decimal(12, 2)
  availableCredit Decimal             @default(0) @db.Decimal(12, 2)
  duration        CreditDurationEnum?
  // payLater        Decimal             @default(0) @db.Decimal(12, 2)
  advanceBalance  Decimal             @default(0) @db.Decimal(12, 2) // AddBalance

  walletBalance Decimal             @default(0) @db.Decimal(12, 2) // WalletBalace----  
  status        CreditAccountStatus @default(ACTIVE)

  freezeReason String?
  frozenAt     DateTime?
  frozenBy     String?

  termConditionNote String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Automation controls
  autoPenaltyEnabled        Boolean @default(true)
  autoCreditIncreaseEnabled Boolean @default(true)
  autoReminderEnabled       Boolean @default(true)

  // optional override
  automationPausedUntil DateTime?

  franchise    Franchise           @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
  payouts      Payout[]
}

enum CreditTransactionEnum {
  ORDER // stock taken → credit reduces
  PAYMENT // payment received → credit increases
  COMMISSION // franchise profit
  ADJUSTMENT // admin correction
  PENALTY // late payment penalty
  REFUND
  CASH_IN
  CREDIT_ACCOUNT
  PAYOUT
}

enum DirectionEnum {
  DEBIT
  CREDIT
}

model CreditTransaction {
  id String @id @default(cuid())

  accountId   String
  franchiseId String

  type   CreditTransactionEnum
  amount Decimal               @db.Decimal(12, 2)

  direction DirectionEnum

  balanceBefore Decimal @db.Decimal(12, 2)
  balanceAfter  Decimal @db.Decimal(12, 2)

  referenceType String?
  referenceId   String?

  description String?

  createdAt DateTime @default(now())

  account   CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  franchise Franchise     @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@index([franchiseId, createdAt])
  @@index([accountId])
}

enum CreditDueStatus {
  PENDING
  OVERDUE
  PAID
}

model CreditDue {
  id          String @id @default(cuid())
  franchiseId String
  accountId   String

  outstanding Decimal  @db.Decimal(12, 2)
  dueDate     DateTime

  status CreditDueStatus @default(PENDING)

  lastReminderAt DateTime?

  createdAt DateTime @default(now())

  @@index([franchiseId, status])
  @@index([dueDate, status])
}

// tracks processing state, 
model CreditProcessingEvent {
  id String @id @default(cuid())

  type String // PENALTY | REMINDER | LIMIT | PAYMENT

  franchiseId String

  referenceId String? // dueId / orderId

  status String @default("QUEUED") // QUEUED | DONE | FAILED

  attempts Int @default(0)

  createdAt DateTime @default(now())

  processedAt DateTime?

  @@index([franchiseId, type])
  @@index([status])
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  FAILED
}

model Payout {
  id              String       @id @default(cuid())
  payoutCode      String?      @unique
  franchiseId     String
  accountId       String
  amount          Decimal      @db.Decimal(12, 2)
  status          PayoutStatus @default(PENDING)
  referenceId     String?
  rejectionReason String?
  notes           String?
  processedAt     DateTime?
  processedBy     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  franchise Franchise     @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  account   CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([franchiseId])
  @@index([status])
}

//END--CREDIT FRANCHISE--

// business accounting snapshot
enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model FranchiseSettlement {
  id          String @id @default(cuid())
  franchiseId String

  totalSales Decimal @db.Decimal(12, 2)
  totalCost  Decimal @db.Decimal(12, 2)
  commission Decimal @db.Decimal(12, 2)
  netPayable Decimal @db.Decimal(12, 2)

  periodStart DateTime
  periodEnd   DateTime

  status SettlementStatus @default(PENDING)

  createdAt DateTime @default(now())

  franchise Franchise @relation(fields: [franchiseId], references: [id])
}

//START--Financial Entries
model FinancialEvent {
  id String @id @default(cuid())

  type String

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique

  gatewayStatus String?

  processed Boolean @default(false)

  amount Decimal @db.Decimal(12, 2)

  metadata  Json?
  createdAt DateTime @default(now())

  ledgerEntries LedgerEntry[]
}

model LedgerEntry {
  id String @id @default(cuid())

  eventId String

  actorType String // CUSTOMER / FRANCHISE / PLATFORM
  actorId   String?

  direction String // CREDIT / DEBIT
  amount    Decimal @db.Decimal(12, 2)

  status String @default("POSTED")

  createdAt DateTime @default(now())

  event FinancialEvent @relation(fields: [eventId], references: [id])
}

//END--Financial Entries

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  sortOrder Int        @default(0)
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  // Relation
  searchHistories SearchHistory[]

  @@index([parentId])
  @@index([name])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  description String?
  slug        String    @unique
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[] @relation("BrandProducts")

  @@index([name])
  @@index([createdAt])
}

model MediaLibrary {
  id          String   @id @default(cuid())
  url         String
  key         String
  mimeType    String
  tag         String?
  orientation String?
  size        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AttributeName {
  id       String  @id @default(cuid())
  title    String
  slug     String  @unique
  isActive Boolean @default(true)

  // Relation
  values AttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([slug])
}

model AttributeValue {
  id       String  @id @default(cuid())
  title    String
  slug     String
  isActive Boolean @default(true)

  // Foreign key
  attributeNameId String

  // Relation
  attributeName AttributeName @relation(fields: [attributeNameId], references: [id])

  variantLinks VariantAttribute[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([slug, attributeNameId])
  @@index([title])
  @@index([slug])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  isActive Boolean @default(true)

  sku String @unique

  // Product list MRP (can be null for legacy rows)
  basePrice      Decimal  @default(0) @db.Decimal(10, 2) //Procurement Price
  wholesalePrice Decimal  @default(0) @db.Decimal(10, 2) //Procurement Price
  price          Decimal  @db.Decimal(10, 2) //Selling Price
  mrpPrice       Decimal? @db.Decimal(10, 2) //StrikeThrough Price

  stock  Int  @default(0)
  gstTax Int? @default(18)
  moq    Int? @default(1)

  imageUrl  String?
  imageUrls Json?

  // ElasticSearch-style optimization
  attributeSummary String // "Color:Red|Size:M"
  searchText       String // "tshirt red m nike cotton"

  // RELATION
  product                        Product                         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes                     VariantAttribute[]
  stockRequests                  StockRequest[] // Relation for variant-based stock requests
  stockTransferLines             StockTransferLine[]
  supplyChainEvents              SupplyChainEvent[] // Relation for variant-related supply chain events
  orderItems                     OrderItem[]
  orderRequestItems              OrderRequestItem[]
  warehouseFulfillmentOrderItems WarehouseFulfillmentOrderItem[]
  returnInventories              ReturnInventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ratingAvg   Decimal @default(0) @db.Decimal(3, 2)
  reviewCount Int     @default(0)

  wishlist                   Wishlist[] // Relation for variant-based wishlist items
  reviews                    ProductReview[]
  returnItemsV2              ReturnItem[]              @relation("VariantReturnItemsV2")
  exchangeItemsV2            ReturnExchangeItem[]      @relation("VariantReturnExchangeItemsV2")
  inventoryMovementsV2       InventoryMovement[]       @relation("VariantInventoryMovementsV2")
  returnInventoryMovementsV2 ReturnInventoryMovement[] @relation("VariantReturnInventoryMovementsV2")
  defectiveInventoryV2       DefectiveInventory[]      @relation("VariantDefectiveInventoryV2")
  starterBundleItems         StarterBundleItem[]
  blockedInventoryV2         BlockedInventory[]        @relation("VariantBlockedInventoryV2")
  guestWishlist              GuestWishlist[]           @relation("GuestWishlistVariant")

  // Procurement relations
  purchaseOrderLines          PurchaseOrderLine[]
  asnLines                    AsnLine[]
  grnLines                    GrnLine[]
  inventoryLedgerEntries      InventoryLedgerEntry[]
  inventoryValuationSnapshots InventoryValuationSnapshot[]
  warehouseDefectiveInventory WarehouseDefectiveInventory[]
  supplierReturnLines         SupplierReturnLine[]

  @@unique([productId, attributeSummary])
  @@index([searchText])
  @@index([productId])
  @@index([price])
  @@index([stock])
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  stock  Int  @default(0)
  gstTax Int? @default(18)
  moq    Int? @default(1)

  features String[] @default([])

  status ProductStatus @default(ACTIVE)

  // We have to delete below first 2 after implement
  //active              Boolean                @default(true)
  visibility Boolean @default(false)

  categoryId String
  brandId    String?

  fastDelivery Boolean @default(false)
  isFeatured   Boolean @default(false)
  occasions    String?

  ratingAvg   Decimal @default(0) @db.Decimal(3, 2)
  reviewCount Int     @default(0)
  viewCount   Int     @default(0)

  /// Default GST % shown on invoices / pricing tools (0 = use outlet default)
  defaultGstRatePercent Decimal @default(0) @db.Decimal(5, 2)

  imageUrl  String?
  imageUrls Json?

  // RELATION
  variants ProductVariant[] // New Relation

  explicitAttributes Json?

  /// Product list MRP (can be null for legacy rows)
  basePrice      Decimal? @default(0) @db.Decimal(10, 2) //Procurement Price
  wholesalePrice Decimal? @default(0) @db.Decimal(10, 2) //Procurement Price
  price          Decimal  @db.Decimal(10, 2) //Selling Price
  mrpPrice       Decimal? @db.Decimal(10, 2) //StrikeThrough Price

  returnWindow Int? @default(30)

  // existing relations (keep yours)
  franchiseStocks                FranchiseStock[]
  hubInventories                 HubInventory[]
  reservations                   InventoryReservation[]
  orderItems                     OrderItem[]
  orderRequestItems              OrderRequestItem[]
  warehouseFulfillmentOrderItems WarehouseFulfillmentOrderItem[]
  promotionTargets               PromotionProduct[]
  replenPolicies                 ReplenishmentPolicy[]
  stockRequests                  StockRequest[]
  stockTransferLines             StockTransferLine[]
  supplyChainEvents              SupplyChainEvent[]
  warehouseStocks                WarehouseStock?
  returnInventories              ReturnInventory[]
  brandRef                       Brand?                          @relation("BrandProducts", fields: [brandId], references: [id])
  category                       Category                        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  seo SeoMeta?

  searchHistories            SearchHistory[]
  wishlist                   Wishlist[]
  reviews                    ProductReview[]
  starterBundleItems         StarterBundleItem[]
  returnItemsV2              ReturnItem[]              @relation("ProductReturnItemsV2")
  exchangeItemsV2            ReturnExchangeItem[]      @relation("ProductReturnExchangeItemsV2")
  inventoryMovementsV2       InventoryMovement[]       @relation("ProductInventoryMovementsV2")
  returnInventoryMovementsV2 ReturnInventoryMovement[] @relation("ProductReturnInventoryMovementsV2")
  defectiveInventoryV2       DefectiveInventory[]      @relation("ProductDefectiveInventoryV2")
  blockedInventoryV2         BlockedInventory[]        @relation("ProductBlockedInventoryV2")
  guestWishlist              GuestWishlist[]           @relation("GuestWishlistProduct")

  // Procurement relations
  purchaseOrderLines          PurchaseOrderLine[]
  asnLines                    AsnLine[]
  grnLines                    GrnLine[]
  inventoryLedgerEntries      InventoryLedgerEntry[]
  inventoryValuationSnapshots InventoryValuationSnapshot[]
  warehouseDefectiveInventory WarehouseDefectiveInventory[]
  supplierReturnLines         SupplierReturnLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
  @@index([brandId])
  @@index([isFeatured])
  @@index([name])
  @@index([slug])
  @@index([visibility])
  @@index([viewCount])
  @@index([reviewCount])
  @@index([status, createdAt])
}

model VariantAttribute {
  variantId        String
  attributeValueId String

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
}

model SeoMeta {
  id       String   @id @default(cuid())
  title    String
  keywords String[]
  tags     String[] @default([])

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([title])
}

model Supplier {
  id            String                    @id @default(cuid())
  code          String                    @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  gstNumber     String?
  panNumber     String?
  address       String?
  paymentTerms  String?
  bankDetails   Json?
  notes         String?
  status        ProcurementSupplierStatus @default(ACTIVE)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  purchaseOrders PurchaseOrder[]
  asns           Asn[]
  grns           GoodsReceiptNote[]
  supplierReturns SupplierReturnOrder[]
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  poNumber             String              @unique
  supplierId           String
  warehouseNodeId      String?
  currency             String              @default("INR")
  expectedDeliveryDate DateTime?
  status               PurchaseOrderStatus @default(DRAFT)
  notes                String?
  totalAmount          Decimal?            @db.Decimal(12, 2)
  createdByUserId      String?
  approvedByUserId     String?
  approvedAt           DateTime?
  sentAt               DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  supplier      Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseNode StockingNode?           @relation(fields: [warehouseNodeId], references: [id])
  lines         PurchaseOrderLine[]
  asns          Asn[]
  grns          GoodsReceiptNote[]
  approvals     PurchaseOrderApproval[]
  supplierReturns SupplierReturnOrder[]
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  variantId       String?
  orderedQty      Int
  moq             Int?
  moqSnapshot     Int?
  unitCost        Decimal  @db.Decimal(12, 2)
  gstPercent      Decimal? @db.Decimal(5, 2)
  lineTotal       Decimal  @db.Decimal(12, 2)
  
  basePrice       Decimal? @db.Decimal(10, 2)
  wholesalePrice  Decimal? @db.Decimal(10, 2)
  price           Decimal? @db.Decimal(10, 2)
  mrpPrice        Decimal? @db.Decimal(10, 2)
  
  receivedQty     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  grnLines      GrnLine[]
  asnLines      AsnLine[]
}

model Asn {
  id                String    @id @default(cuid())
  asnNumber         String    @unique
  purchaseOrderId   String?
  supplierId        String
  supplierInvoiceNo String?
  vehicleNumber     String?
  courier           String?
  trackingNumber    String?
  expectedArrival   DateTime?
  status            AsnStatus @default(DRAFT)
  shipmentNote      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines         AsnLine[]
  grns          GoodsReceiptNote[]
}

model AsnLine {
  id                  String   @id @default(cuid())
  asnId               String
  purchaseOrderLineId String?
  productId           String
  variantId           String?
  expectedQty         Int
  shippedQty          Int      @default(0)
  createdAt           DateTime @default(now())

  asn               Asn                @relation(fields: [asnId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  variant           ProductVariant?    @relation(fields: [variantId], references: [id])
}

model GoodsReceiptNote {
  id              String    @id @default(cuid())
  grnNumber       String    @unique
  purchaseOrderId String
  asnId           String?
  supplierId      String
  warehouseNodeId String?
  status          GrnStatus @default(DRAFT)
  postedAt        DateTime?
  postedByUserId  String?
  reversalReason  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  purchaseOrder      PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  asn                Asn?                   @relation(fields: [asnId], references: [id])
  supplier           Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseNode      StockingNode?          @relation(fields: [warehouseNodeId], references: [id])
  lines              GrnLine[]
  qualityInspections QualityInspection[]
  ledgerEntries      InventoryLedgerEntry[]
}

model GrnLine {
  id                  String   @id @default(cuid())
  grnId               String
  purchaseOrderLineId String
  productId           String
  variantId           String?
  receivedQty         Int
  acceptedQty         Int
  damagedQty          Int
  rejectedQty         Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  grn               GoodsReceiptNote   @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine  @relation(fields: [purchaseOrderLineId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  variant           ProductVariant?    @relation(fields: [variantId], references: [id])
  qualityInspection QualityInspection?
}

model QualityInspection {
  id                String                  @id @default(cuid())
  grnId             String
  grnLineId         String?                 @unique
  templateId        String?
  status            QualityInspectionStatus @default(PENDING)
  inspectedByUserId String?
  inspectedAt       DateTime?
  approvedByUserId  String?
  approvedAt        DateTime?
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  grn     GoodsReceiptNote          @relation(fields: [grnId], references: [id], onDelete: Cascade)
  grnLine GrnLine?                  @relation(fields: [grnLineId], references: [id])
  results QualityInspectionResult[]
}

model QualityInspectionResult {
  id            String   @id @default(cuid())
  inspectionId  String
  checklistKey  String
  expectedValue String?
  actualValue   String?
  passed        Boolean
  createdAt     DateTime @default(now())

  inspection QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model InventoryLedgerEntry {
  id              String          @id @default(cuid())
  grnId           String?
  productId       String
  variantId       String?
  warehouseNodeId String?
  transactionType LedgerEntryType
  quantity        Int
  unitCost        Decimal         @db.Decimal(12, 2)
  runningBalance  Int
  referenceType   String
  referenceId     String
  note            String?
  createdAt       DateTime        @default(now())

  grn           GoodsReceiptNote? @relation(fields: [grnId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  variant       ProductVariant?   @relation(fields: [variantId], references: [id])
  warehouseNode StockingNode?     @relation(fields: [warehouseNodeId], references: [id])
}

model InventoryValuationSnapshot {
  id              String   @id @default(cuid())
  productId       String
  variantId       String?
  warehouseNodeId String?
  onHandQty       Int
  weightedAvgCost Decimal  @db.Decimal(12, 2)
  landedCost      Decimal  @db.Decimal(12, 2)
  inventoryValue  Decimal  @db.Decimal(12, 2)
  sourceRefType   String
  sourceRefId     String
  createdAt       DateTime @default(now())

  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  warehouseNode StockingNode?   @relation(fields: [warehouseNodeId], references: [id])
}

model PurchaseOrderApproval {
  id              String           @id @default(cuid())
  purchaseOrderId String
  approverUserId  String
  decision        ApprovalDecision
  comment         String?
  createdAt       DateTime         @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model ProcurementAuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  actorUserId String?
  details     Json?
  createdAt   DateTime @default(now())
}

model WarehouseStock {
  productId         String  @id
  quantity          Int
  lowStockThreshold Int     @default(5)
  /// Units reserved for internal commitments (e.g. future DC allocation); sellable = quantity - reserved.
  reserved          Int     @default(0)
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model FranchiseStock {
  franchiseId       String
  productId         String
  variantId         String    @default("")
  quantity          Int
  lowStockThreshold Int       @default(5)
  /// Units reserved for unpaid online checkout (ATP excludes this portion until paid or released).
  reserved          Int       @default(0)
  franchise         Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([franchiseId, productId, variantId])
  @@index([franchiseId])
  @@index([productId])
  @@index([variantId])
}

enum PaymentModeEnum {
  // Channel (POS)
  CASH
  CARD
  UPI
  QR
  NETBANKING

  // Channel (Online)
  COD
  ONLINE
}

model Order {
  id             String       @id @default(cuid())
  orderNumber    String       @unique
  orderRequestId String?      @unique
  status         OrderStatus  @default(PENDING)
  franchiseId    String
  customerId     String? // UserId of customer who placed the order request
  total          Decimal      @db.Decimal(12, 2)
  latitude       Float
  longitude      Float
  addressJson    String
  giftMessage    String?
  giftWrap       Boolean      @default(false)
  giftWrapperFee Decimal      @default(0.00) @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  channel        OrderChannel @default(ONLINE)
  saleType       String?

  /// Snapshot of buyer, line names, tax split, payment — for printing / compliance
  billingSnapshot Json?

  // Payment Mode (important for distinguishing POS vs online orders, and for financial reporting)
  paymentMode PaymentModeEnum

  soldByUserId        String?
  retailCustomerId    String?
  onlinePaymentStatus OnlinePaymentStatus? @default(UNPAID) // Future we have to name with paymentStatus
  paidAt              DateTime?
  paymentProvider     String?
  paymentReference    String?
  cartId              String?

  discountAmount Decimal? @db.Decimal(10, 2)
  couponCode     String?

  /// Retail invoice id for POS counter sales (unique when set)
  invoiceNumber String? @unique

  isApproved       Boolean @default(false)
  approvedByUserId String?

  franchisePaybleAmount Decimal?          @default(0.00) @db.Decimal(10, 2)
  deliveredAt           DateTime?
  referralCode          String?
  settlements           OrderSettlement[]
  /// Invoice Relation
  invoices              Invoice[]         @relation("OrderInvoices")
  orderRequest          OrderRequest?     @relation("OrderRequestToOrder", fields: [orderRequestId], references: [id])

  returns      FranchiseReturn[]
  reservations InventoryReservation[]

  customer         Customer?       @relation(fields: [customerId], references: [id])
  franchise        Franchise       @relation(fields: [franchiseId], references: [id])
  retailCustomer   RetailCustomer? @relation(fields: [retailCustomerId], references: [id])
  soldBy           User?           @relation("PosOrdersSoldBy", fields: [soldByUserId], references: [id])
  items            OrderItem[]
  reviews          ProductReview[]
  returnRequestsV2 ReturnRequest[] @relation("OrderReturnRequestsV2")

  @@index([franchiseId, channel])
  @@index([cartId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int

  // Snapshot fields
  productName String?
  sku         String?
  variantName String?

  unitPrice Decimal  @db.Decimal(10, 2)
  mrpPrice  Decimal? @db.Decimal(10, 2)

  gstPercent Decimal? @db.Decimal(5, 2)

  discountAmount Decimal? @db.Decimal(10, 2)
  taxAmount      Decimal? @db.Decimal(10, 2)

  finalAmount Decimal? @db.Decimal(10, 2)

  imageUrl String?
  //End Snapshot

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model StockRequest {
  id          String @id @default(cuid())
  franchiseId String
  productId   String

  /// Product variant ID (if requesting for specific variant, otherwise null for base product)
  variantId String?

  quantity Int
  type     StockRequestType   @default(STOCK_REQUEST)
  status   StockRequestStatus @default(PENDING)
  note     String?

  reviewedById String?
  reviewedAt   DateTime?

  rejectReason String?

  paymentMode    StockRequestPaymentMode?
  creditDuration CreditDurationEnum?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvedQuantity    Int?
  unitPriceAtApproval Decimal? @db.Decimal(10, 2)
  gstRatePercent      Decimal? @db.Decimal(5, 2)

  // START..MONEY_MOVEMENT_FIELDS (PAYMENT SOURCE FRANCHISE'S CREDIT_ACCOUNT)
  billingSubtotal Decimal? @db.Decimal(12, 2)
  billingTax      Decimal? @db.Decimal(12, 2)
  billingTotal    Decimal? @db.Decimal(12, 2)
  paidAmount      Decimal  @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal? @db.Decimal(12, 2)
  isFullyPaid     Boolean  @default(false)
  // END..MONEY_MOVEMENT_FIELDS

  paymentStatus     StockRequestPaymentStatus @default(UNPAID)
  paymentReceivedAt DateTime?
  paymentReference  String?
  paymentNote       String?

  invoiceNumber String?   @unique
  /// Invoice Relation
  invoices      Invoice[] @relation("StockRequestInvoices")

  deliveries        InboundDelivery[]
  returns           FranchiseReturn[]
  reservations      InventoryReservation[]
  franchise         Franchise                   @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  product           Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant?             @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reviewedBy        User?                       @relation("StockRequestReviewer", fields: [reviewedById], references: [id])
  returnRequestsV2  ReturnRequest[]             @relation("StockRequestReturnRequestsV2")
  bundleAssignments FranchiseBundleAssignment[]
}

model InboundDelivery {
  id                String                      @id @default(cuid())
  franchiseId       String
  stockRequestId    String?
  status            DeliveryStatus              @default(SCHEDULED)
  carrier           String?
  trackingCode      String?
  expectedAt        DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  /// When true, franchise stock for this shipment has already been applied (idempotent receipt).
  stockApplied      Boolean                     @default(false)
  /// Set when status first becomes IN_TRANSIT (hub dispatch / released to carrier).
  dispatchedAt      DateTime?
  transportLaneId   String?
  /// External carrier / AWB reference
  carrierReference  String?
  slaDueAt          DateTime?
  /// Structured ASN lines (e.g. [{ sku, qtyShipped }])
  asnPayload        Json?
  quantityShipped   Int?
  quantityReceived  Int?
  discrepancyNote   String?
  damagedQuantity   Int                         @default(0)
  discrepancyStatus InboundDiscrepancyStatus    @default(NONE)
  franchise         Franchise                   @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  stockRequest      StockRequest?               @relation(fields: [stockRequestId], references: [id])
  transportLane     TransportLane?              @relation(fields: [transportLaneId], references: [id])
  bundleAssignments FranchiseBundleAssignment[]

  @@index([transportLaneId])
}

model FranchiseReturn {
  id                 String                @id @default(cuid())
  franchiseId        String
  orderId            String?
  customerId         String?
  stockRequestId     String?
  isDeleted          Boolean               @default(false)
  deletedAt          DateTime?
  reason             String
  resolutionNote     String?
  refundRequested    Boolean               @default(false)
  returnType         ReturnInventoryEnum?
  oldItems           Json?
  newItems           Json?
  oldTotalAmount     Decimal?              @db.Decimal(12, 2)
  newTotalAmount     Decimal?              @db.Decimal(12, 2)
  finalPayableAmount Decimal?              @db.Decimal(12, 2)
  processedAt        DateTime?
  status             FranchiseReturnStatus @default(PENDING)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  franchise          Franchise             @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  order              Order?                @relation(fields: [orderId], references: [id])
  customer           User?                 @relation("FranchiseReturnCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  stockRequest       StockRequest?         @relation(fields: [stockRequestId], references: [id])

  @@index([franchiseId, status])
  @@index([orderId])
  @@index([customerId])
  @@index([stockRequestId])
  @@index([returnType])
  @@index([isDeleted, createdAt])
}

enum ReturnInventoryEnum {
  RETURN
  EXCHANGE
  REFUND
}

enum ReturnSourceType {
  ORDER
  STOCK_REQUEST
  CUSTOMER_ORDER
}

enum ReturnConflictInventoryStatus {
  OPEN
  RESOLVED
  CLOSED
  PENDING_QC
}

enum ReturnInventoryKind {
  DEFECTIVE
  CONFLICT
  RETURN
}

model ReturnInventory {
  id          String                         @id @default(cuid())
  productId   String
  variantId   String?
  franchiseId String
  customerId  String?
  quantity    Int
  sourceType  ReturnSourceType
  sourceId    String
  kind        ReturnInventoryKind
  status      ReturnConflictInventoryStatus? @default(OPEN)
  createdAt   DateTime                       @default(now())

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  franchise Franchise       @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  customer  Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([franchiseId, createdAt])
  @@index([productId])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([kind])
}

model Promotion {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  description       String?
  percentOff        Decimal            @db.Decimal(5, 2)
  active            Boolean            @default(true)
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  /// When true, discount applies to every active product unless overridden by more specific promos (best % wins per SKU).
  applyToAll        Boolean            @default(true)
  promotionProducts PromotionProduct[]
}

model PromotionProduct {
  promotionId String
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PartitionedAuditLog {
  id         String   @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@id([id, createdAt])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
}

model AuditArchiveRegistry {
  id            String   @id @default(cuid())
  partitionName String
  s3Key         String
  fromDate      DateTime
  toDate        DateTime
  recordCount   Int
  checksum      String
  uploadedAt    DateTime @default(now())
  verified      Boolean  @default(false)
  deletedFromDb Boolean  @default(false)

  @@index([partitionName])
  @@index([fromDate, toDate])
}

model FranchiseNotice {
  id              String                @id @default(cuid())
  title           String
  body            String
  audience        NoticeAudience
  franchiseId     String?
  createdByUserId String
  publishedAt     DateTime              @default(now())
  createdBy       User                  @relation("FranchiseNoticeAuthor", fields: [createdByUserId], references: [id])
  franchise       Franchise?            @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  reads           FranchiseNoticeRead[]
}

model FranchiseNoticeRead {
  id       String          @id @default(cuid())
  noticeId String
  userId   String
  readAt   DateTime        @default(now())
  notice   FranchiseNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
}

model SupportTicket {
  id               String              @id @default(cuid())
  franchiseId      String
  type             SupportTicketType   @default(GENERAL)
  subject          String
  status           SupportTicketStatus @default(OPEN)
  priority         TicketPriority      @default(MEDIUM)
  createdByUserId  String
  assignedToUserId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  assignedTo       User?               @relation("SupportTicketAssignee", fields: [assignedToUserId], references: [id])
  createdBy        User                @relation("SupportTicketCreator", fields: [createdByUserId], references: [id])
  franchise        Franchise           @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  messages         TicketMessage[]

  @@index([franchiseId, status])
}

model TicketMessage {
  id           String        @id @default(cuid())
  ticketId     String
  authorUserId String
  body         String
  isInternal   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  author       User          @relation("TicketMessageAuthor", fields: [authorUserId], references: [id])
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model FranchiseDocument {
  id               String                @id @default(cuid())
  franchiseId      String
  kind             FranchiseDocumentKind
  title            String
  fileUrl          String
  uploadedByUserId String?
  verifiedAt       DateTime?
  verifiedByUserId String?
  expiresAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  franchise        Franchise             @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  uploadedBy       User?                 @relation("FranchiseDocumentUploader", fields: [uploadedByUserId], references: [id])
  verifiedBy       User?                 @relation("FranchiseDocumentVerifier", fields: [verifiedByUserId], references: [id])

  @@unique([franchiseId, kind])
  @@index([franchiseId])
}

model WebhookEndpoint {
  id         String            @id @default(cuid())
  label      String?
  url        String
  secret     String?
  /// Comma-separated event names, or * for all queued events
  events     String            @default("*")
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  endpointId   String
  event        String
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  attempts     Int                   @default(0)
  lastError    String?
  responseCode Int?
  createdAt    DateTime              @default(now())
  completedAt  DateTime?
  endpoint     WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
}

model StockingNode {
  id                          String                       @id @default(cuid())
  type                        StockingNodeType
  name                        String
  code                        String                       @unique
  parentId                    String?
  franchiseId                 String?                      @unique
  sortOrder                   Int                          @default(0)
  active                      Boolean                      @default(true)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  hubInventories              HubInventory[]
  transfersFrom               StockTransfer[]              @relation("TransferFrom")
  transfersTo                 StockTransfer[]              @relation("TransferTo")
  franchise                   Franchise?                   @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  parent                      StockingNode?                @relation("StockingNodeTree", fields: [parentId], references: [id])
  children                    StockingNode[]               @relation("StockingNodeTree")
  supplyChainEvents           SupplyChainEvent[]
  lanesTo                     TransportLane[]              @relation("LaneDestNode")
  lanesFrom                   TransportLane[]              @relation("LaneOriginNode")
  purchaseOrders              PurchaseOrder[]
  grns                        GoodsReceiptNote[]
  inventoryLedgerEntries      InventoryLedgerEntry[]
  inventoryValuationSnapshots InventoryValuationSnapshot[]

  @@index([parentId])
  @@index([type, active])
}

model HubInventory {
  stockingNodeId String
  productId      String
  quantity       Int          @default(0)
  reserved       Int          @default(0)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockingNode   StockingNode @relation(fields: [stockingNodeId], references: [id], onDelete: Cascade)

  @@id([stockingNodeId, productId])
}

model TransportLane {
  id                 String            @id @default(cuid())
  code               String            @unique
  name               String
  originNodeId       String
  destNodeId         String
  defaultSlaHours    Int               @default(72)
  allocationPriority Int               @default(0)
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  inboundDeliveries  InboundDelivery[]
  destNode           StockingNode      @relation("LaneDestNode", fields: [destNodeId], references: [id], onDelete: Cascade)
  originNode         StockingNode      @relation("LaneOriginNode", fields: [originNodeId], references: [id], onDelete: Cascade)

  @@index([originNodeId, destNodeId])
}

model StockTransfer {
  id              String              @id @default(cuid())
  fromNodeId      String
  toNodeId        String
  status          StockTransferStatus @default(DRAFT)
  note            String?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  fromNode        StockingNode        @relation("TransferFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode          StockingNode        @relation("TransferTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  lines           StockTransferLine[]

  @@index([fromNodeId, status])
  @@index([toNodeId, status])
}

model StockTransferLine {
  id                String          @id @default(cuid())
  transferId        String
  productId         String
  variantId         String?
  quantityRequested Int
  quantityShipped   Int?
  quantityReceived  Int?
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  transfer          StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([variantId])
}

model ReplenishmentPolicy {
  id           String    @id @default(cuid())
  franchiseId  String
  productId    String
  minQty       Int       @default(0)
  maxQty       Int       @default(10)
  reorderPoint Int       @default(2)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  franchise    Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([franchiseId, productId])
  @@index([franchiseId, active])
}

model SupplyChainEvent {
  id             String          @id @default(cuid())
  eventName      String
  stockingNodeId String?
  productId      String?
  variantId      String?
  quantityDelta  Int?
  refType        String
  refId          String?
  payload        Json?
  createdAt      DateTime        @default(now())
  product        Product?        @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  stockingNode   StockingNode?   @relation(fields: [stockingNodeId], references: [id])

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([stockingNodeId, createdAt])
  @@index([eventName, createdAt])
}

model DomainEventOutbox {
  id           String             @id @default(cuid())
  eventName    String
  payload      Json
  status       DomainOutboxStatus @default(PENDING)
  attempts     Int                @default(0)
  lastError    String?
  createdAt    DateTime           @default(now())
  dispatchedAt DateTime?
  /// When set, automated retry should not run before this time (exponential backoff).
  nextRetryAt  DateTime?

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
}

model InventoryReservation {
  id             String                     @id @default(cuid())
  kind           InventoryReservationKind
  status         InventoryReservationStatus @default(ACTIVE)
  productId      String
  quantity       Int
