  length  Decimal @default(10) @db.Decimal(10, 2)
  breadth Decimal @default(10) @db.Decimal(10, 2)
  height  Decimal @default(10) @db.Decimal(10, 2)
  weight  Decimal @default(0.5) @db.Decimal(10, 2)

