  sellerGstin   String?
  buyerGstin    String?
  placeOfSupply String?

  /// SOFT DELETE
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  status InvoiceStatus @default(GENERATED)

  order_date DateTime @default(now())
  issuedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  parentInvoiceId String?
  parentInvoice   Invoice?  @relation("InvoiceSubDocuments", fields: [parentInvoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
